{
  "name": "hono-openapi-docs",
  "version": "0.1.2",
  "description": "Ergonomic, zero-boilerplate OpenAPI 3.2 documentation for Hono with Standard Schema and router-scoped nested tags",
  "license": "MIT",
  "author": "xmreur",
  "repository": {
    "type": "git",
    "url": "https://github.com/xmreur/hono-openapi-docs.git"
  },
  "homepage": "https://github.com/xmreur/hono-openapi-docs#readme",
  "bugs": {
    "url": "https://github.com/xmreur/hono-openapi-docs/issues"
  },
  "keywords": [
    "hono",
    "openapi",
    "openapi-3.2",
    "swagger",
    "scalar",
    "standard-schema",
    "zod",
    "valibot",
    "bun"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external hono --external @standard-schema/spec && tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "example": "bun run ./examples/full-api/index.ts"
  },
  "peerDependencies": {
    "hono": ">=4.0.0",
    "@standard-schema/spec": "^1.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@standard-schema/spec": "^1.1.0",
    "@types/bun": "latest",
    "hono": "^4.0.0",
    "typescript": "^5.8.0",
    "valibot": "^1.0.0",
    "zod": "^4.0.0"
  }
}
